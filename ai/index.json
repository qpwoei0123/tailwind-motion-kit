{
  "spec_version": "0.1.0",
  "library": {
    "name": "tailwind-motion-kit",
    "version": "0.0.1",
    "base_class_prefix": "animate-"
  },
  "tokens": {
    "duration": ["animate-duration-150", "animate-duration-300", "animate-duration-500", "animate-duration-700", "animate-duration-1000"],
    "delay": ["animate-delay-0", "animate-delay-75", "animate-delay-150", "animate-delay-300", "animate-delay-500"],
    "easing": ["animate-ease-linear", "animate-ease-in", "animate-ease-out", "animate-ease-in-out"],
    "direction": ["animate-direction-normal", "animate-direction-reverse", "animate-direction-alternate"],
    "fill": ["animate-fill-none", "animate-fill-forwards", "animate-fill-backwards", "animate-fill-both"]
  },
  "animations": [
    {
      "name": "fade-in",
      "class": "animate-fade-in",
      "intent": ["enter", "reveal"],
      "use_when": ["modal open", "toast enter", "card appear"],
      "avoid_when": ["high urgency feedback"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "fade-out",
      "class": "animate-fade-out",
      "intent": ["exit", "dismiss"],
      "use_when": ["dialog close", "popover close", "overlay fade"],
      "avoid_when": ["error state emphasis"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "fade-up",
      "class": "animate-fade-up",
      "intent": ["enter", "reveal"],
      "use_when": ["list item appear", "section reveal", "card enter"],
      "avoid_when": ["large distance transitions"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "fade-down",
      "class": "animate-fade-down",
      "intent": ["enter", "reveal"],
      "use_when": ["tooltip appear", "dropdown enter", "top banner reveal"],
      "avoid_when": ["bottom-origin surfaces"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "fade-blur-in",
      "class": "animate-fade-blur-in",
      "intent": ["reveal", "focus"],
      "use_when": ["hero reveal", "image sharpen", "featured card enter"],
      "avoid_when": ["dense text blocks", "tiny icons"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "fade-blur-out",
      "class": "animate-fade-blur-out",
      "intent": ["exit", "dismiss"],
      "use_when": ["overlay dismiss", "scene transition", "content de-emphasis"],
      "avoid_when": ["critical feedback", "rapid UI close loops"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "blur-in",
      "class": "animate-blur-in",
      "intent": ["reveal", "focus"],
      "use_when": ["image sharpen", "loading completion", "depth transition"],
      "avoid_when": ["plain text emphasis"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "blur-out",
      "class": "animate-blur-out",
      "intent": ["exit", "de-emphasize"],
      "use_when": ["background defocus", "scene exit", "layer transition"],
      "avoid_when": ["urgent alerts"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "focus-in",
      "class": "animate-focus-in",
      "intent": ["focus", "reveal"],
      "use_when": ["hero reveal", "spotlight state", "featured content"],
      "avoid_when": ["compact controls", "busy tables"],
      "pair_with": ["animate-duration-500", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "focus-out",
      "class": "animate-focus-out",
      "intent": ["exit", "de-emphasize"],
      "use_when": ["scene exit", "focus handoff", "hero dismiss"],
      "avoid_when": ["critical state changes"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "glow-in",
      "class": "animate-glow-in",
      "intent": ["highlight", "reveal"],
      "use_when": ["neon highlight", "success emphasis", "brand accent"],
      "avoid_when": ["body text", "subtle enterprise UIs"],
      "pair_with": ["animate-duration-500", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "slide-in-up",
      "class": "animate-slide-in-up",
      "intent": ["enter", "nudge-attention"],
      "use_when": ["toast enter", "bottom element reveal", "snackbar appear"],
      "avoid_when": ["dense table rows"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "slide-in-left",
      "class": "animate-slide-in-left",
      "intent": ["enter", "transition"],
      "use_when": ["drawer enter", "carousel change", "side panel reveal"],
      "avoid_when": ["centered modal open"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "slide-in-right",
      "class": "animate-slide-in-right",
      "intent": ["enter", "transition"],
      "use_when": ["toast enter", "side panel reveal", "next-step surface"],
      "avoid_when": ["centered modal open"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "slide-in-bottom",
      "class": "animate-slide-in-bottom",
      "intent": ["enter", "reveal"],
      "use_when": ["bottom sheet enter", "mobile action tray", "sheet open"],
      "avoid_when": ["top anchored surfaces"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "slide-out-down",
      "class": "animate-slide-out-down",
      "intent": ["exit", "dismiss"],
      "use_when": ["toast exit", "snackbar dismiss", "lightweight panel close"],
      "avoid_when": ["top anchored surfaces"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "slide-out-up",
      "class": "animate-slide-out-up",
      "intent": ["exit", "dismiss"],
      "use_when": ["tooltip close", "top banner dismiss", "stacked list removal"],
      "avoid_when": ["bottom sheets"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "slide-out-left",
      "class": "animate-slide-out-left",
      "intent": ["exit", "transition"],
      "use_when": ["drawer close", "carousel previous", "side panel dismiss"],
      "avoid_when": ["centered modal close"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "slide-out-right",
      "class": "animate-slide-out-right",
      "intent": ["exit", "transition"],
      "use_when": ["panel close", "wizard next handoff", "temporary tray dismiss"],
      "avoid_when": ["centered modal close"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "slide-out-bottom",
      "class": "animate-slide-out-bottom",
      "intent": ["exit", "dismiss"],
      "use_when": ["bottom sheet exit", "mobile action tray close", "sheet dismiss"],
      "avoid_when": ["top anchored surfaces"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "accordion-down",
      "class": "animate-accordion-down",
      "intent": ["expand", "reveal"],
      "use_when": ["faq open", "accordion open", "collapsible section expand"],
      "avoid_when": ["unknown content height without css var"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "accordion-up",
      "class": "animate-accordion-up",
      "intent": ["collapse", "dismiss"],
      "use_when": ["faq close", "accordion close", "collapsible section collapse"],
      "avoid_when": ["unknown content height without css var"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "scale-in",
      "class": "animate-scale-in",
      "intent": ["enter", "focus"],
      "use_when": ["menu open", "small popover", "compact dialog"],
      "avoid_when": ["full-screen transitions"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "scale-out",
      "class": "animate-scale-out",
      "intent": ["exit", "dismiss"],
      "use_when": ["menu close", "popover dismiss", "compact dialog exit"],
      "avoid_when": ["large containers"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "zoom-in",
      "class": "animate-zoom-in",
      "intent": ["enter", "emphasis"],
      "use_when": ["modal open", "media focus", "hero card enter"],
      "avoid_when": ["micro interactions", "dense list items"],
      "pair_with": ["animate-duration-300", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "zoom-out",
      "class": "animate-zoom-out",
      "intent": ["exit", "dismiss"],
      "use_when": ["modal close", "focused media exit", "hero card dismiss"],
      "avoid_when": ["micro interactions"],
      "pair_with": ["animate-duration-300", "animate-ease-in", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "bounce-in",
      "class": "animate-bounce-in",
      "intent": ["feedback", "emphasis"],
      "use_when": ["badge pop", "reward moment", "playful confirmation"],
      "avoid_when": ["serious enterprise flows", "critical alerts"],
      "pair_with": ["animate-duration-700", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "wobble",
      "class": "animate-wobble",
      "intent": ["feedback", "warning"],
      "use_when": ["error nudge", "invalid input hint", "playful warning"],
      "avoid_when": ["large surfaces", "continuous looping"],
      "pair_with": ["animate-duration-700", "animate-ease-in-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "jelly",
      "class": "animate-jelly",
      "intent": ["emphasis", "feedback"],
      "use_when": ["cta click feedback", "badge highlight", "success micro interaction"],
      "avoid_when": ["critical alerts", "large blocks of text"],
      "pair_with": ["animate-duration-500", "animate-ease-in-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "soft-pulse",
      "class": "animate-soft-pulse",
      "intent": ["status", "ambient"],
      "use_when": ["live status", "presence dot", "soft attention loop"],
      "avoid_when": ["urgent alerts", "large cards"],
      "pair_with": ["animate-duration-1000", "animate-ease-in-out", "animate-repeat-infinite"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "float",
      "class": "animate-float",
      "intent": ["ambient", "decorative"],
      "use_when": ["ambient card", "hero illustration", "background accent"],
      "avoid_when": ["forms", "data-dense components"],
      "pair_with": ["animate-duration-1000", "animate-ease-in-out", "animate-repeat-infinite"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "shake-x",
      "class": "animate-shake-x",
      "intent": ["error", "feedback"],
      "use_when": ["form error", "invalid credential", "blocked action"],
      "avoid_when": ["success states", "large layout containers"],
      "pair_with": ["animate-duration-500", "animate-ease-in-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    },
    {
      "name": "rotate-in",
      "class": "animate-rotate-in",
      "intent": ["reveal", "emphasis"],
      "use_when": ["icon reveal", "badge flourish", "playful entry"],
      "avoid_when": ["body text", "serious workflows"],
      "pair_with": ["animate-duration-500", "animate-ease-out", "animate-fill-both"],
      "a11y": { "reduced_motion": "motion-reduce:animate-none" }
    }
  ]
}
